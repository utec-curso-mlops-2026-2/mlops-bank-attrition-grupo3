{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LogsCloudWatch",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-2:484815418393:log-group:/aws/lambda/bank-attrition-*"
    },
    {
      "Sid": "BucketProyecto",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketVersioning"],
      "Resource": "arn:aws:s3:::mlops-bank-attrition-grupo3-484815418393"
    },
    {
      "Sid": "ObjetosProyecto",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject"],
      "Resource": "arn:aws:s3:::mlops-bank-attrition-grupo3-484815418393/*"
    }
  ]
}
