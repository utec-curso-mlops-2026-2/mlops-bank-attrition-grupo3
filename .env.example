# Copiar a .env solo si la implementación del equipo decide cargarlo.
# La plantilla no carga automáticamente este archivo.
# Usar un perfil/SSO local o un rol de AWS en ejecución; no añadir claves aquí.
AWS_PROFILE=REEMPLAZAR_PERFIL_LOCAL
AWS_REGION=REEMPLAZAR_REGION
MLOPS_DATA_BUCKET=REEMPLAZAR_BUCKET
MLOPS_DATA_PREFIX=REEMPLAZAR_PREFIJO
DATABRICKS_HOST=https://REEMPLAZAR_WORKSPACE.cloud.databricks.com
DATABRICKS_TOKEN=REEMPLAZAR_TOKEN
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
MLFLOW_EXPERIMENT_NAME=/Shared/utec-bank-attrition